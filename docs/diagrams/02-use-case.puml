@startuml use-case
!include style.iuml
title PrintXpress - Use Case Diagram
left to right direction

actor Customer as C
actor "Staff member" as S
actor "Notification\nservice" as N <<system>>

rectangle "PrintXpress mobile app" {
  package "Account" {
    usecase "Register" as UC1
    usecase "Log in\n(email or phone)" as UC2
    usecase "Manage profile\n& password" as UC3
    usecase "Manage delivery\naddresses" as UC4
    usecase "Log out" as UC5
  }
  package "Browse & order" {
    usecase "Browse products\nby category" as UC6
    usecase "Search products" as UC7
    usecase "View product details\n& specifications" as UC8
    usecase "Place order" as UC9
    usecase "Upload artwork" as UC10
    usecase "Enter custom text" as UC11
    usecase "Apply promo code" as UC12
    usecase "Choose pickup /\ndelivery & date" as UC13
  }
  package "Order management" {
    usecase "View order history" as UC14
    usecase "Track order status" as UC15
    usecase "Reschedule order" as UC16
    usecase "Cancel order" as UC17
    usecase "Update order status" as UC18
  }
  package "Notifications & offers" {
    usecase "View notifications" as UC19
    usecase "View seasonal offers" as UC20
    usecase "Send promotion" as UC21
  }
  package "Design support" {
    usecase "View sample gallery" as UC22
    usecase "Read print guidelines" as UC23
    usecase "Read FAQs" as UC24
    usecase "Contact support" as UC25
    usecase "Reply to support\nrequest" as UC26
  }
}

C --> UC1
C --> UC2
C --> UC3
C --> UC4
C --> UC5
C --> UC6
C --> UC7
C --> UC8
C --> UC9
C --> UC14
C --> UC15
C --> UC16
C --> UC17
C --> UC19
C --> UC20
C --> UC22
C --> UC23
C --> UC24
C --> UC25

UC9 ..> UC13 : <<include>>
UC9 <.. UC10 : <<extend>>
UC9 <.. UC11 : <<extend>>
UC9 <.. UC12 : <<extend>>
UC16 ..> UC15 : <<include>>
UC17 ..> UC15 : <<include>>

S --> UC18
S --> UC21
S --> UC26

UC18 --> N
UC21 --> N
UC9 --> N
N --> UC19
@enduml
