<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Order / promotion alerts (Android 13+ asks the user) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PrintXpressApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrintExpress"
        tools:targetApi="37">

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.RegisterActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.main.MainActivity" android:windowSoftInputMode="adjustPan" />

        <activity android:name=".ui.product.ProductDetailActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.order.OrderDetailActivity" />

        <activity android:name=".ui.profile.EditProfileActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.profile.AddressesActivity" />
        <activity android:name=".ui.profile.AddressFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.profile.DesignsActivity" />
        <activity android:name=".ui.profile.NotificationsActivity" />
        <activity android:name=".ui.profile.StaffActivity" />

        <activity android:name=".ui.support.GalleryActivity" />
        <activity android:name=".ui.support.InfoListActivity" />
        <activity android:name=".ui.support.PromotionsActivity" />
        <activity android:name=".ui.support.SupportActivity" android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
