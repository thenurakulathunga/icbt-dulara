<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- User header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textAvatar"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Title" />

                <TextView
                    android:id="@+id/textEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Body" />

                <TextView
                    android:id="@+id/textPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Account -->
        <TextView style="@style/PrintXpress.SectionLabel" android:text="Account" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_edit"
                    app:rowSubtitle="Name, email, phone and password"
                    app:rowTitle="@string/edit_profile" />

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_location"
                    app:rowSubtitle="Where we deliver your prints"
                    app:rowTitle="@string/my_addresses" />

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowDesigns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_folder"
                    app:rowSubtitle="Artwork you uploaded"
                    app:rowTitle="@string/my_designs" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Updates -->
        <TextView style="@style/PrintXpress.SectionLabel" android:text="Updates" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_bell"
                    app:rowTitle="@string/notifications" />

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowOffers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_offer"
                    app:rowTitle="@string/offers_promotions" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Help -->
        <TextView style="@style/PrintXpress.SectionLabel" android:text="Design help" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_image"
                    app:rowTitle="@string/gallery" />

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowGuidelines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_doc"
                    app:rowTitle="@string/guidelines" />

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowFaqs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_help"
                    app:rowTitle="@string/faqs" />

                <com.example.printexpress.ui.common.MenuRowView
                    android:id="@+id/rowSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_chat"
                    app:rowTitle="@string/support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Demo -->
        <TextView style="@style/PrintXpress.SectionLabel" android:text="Demo" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.printexpress.ui.common.MenuRowView
                android:id="@+id/rowStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_print"
                app:rowSubtitle="Update order status, send offers, reply to support"
                app:rowTitle="Staff demo panel" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <com.example.printexpress.ui.common.MenuRowView
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowDanger="true"
                app:rowIcon="@drawable/ic_logout"
                app:rowTitle="@string/logout" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="PrintXpress v1.0"
            android:textAppearance="@style/TextAppearance.PrintXpress.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
