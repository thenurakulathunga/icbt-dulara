<?xml version="1.0" encoding="utf-8"?>
<!-- Expandable card: guideline or FAQ -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_soft"
                android:contentDescription="@null"
                android:padding="8dp"
                app:tint="@color/px_primary" />

            <TextView
                android:id="@+id/textHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.PrintXpress.Subtitle" />

            <ImageView
                android:id="@+id/imageExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_expand"
                app:tint="@color/px_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/textBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.PrintXpress.Body" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
