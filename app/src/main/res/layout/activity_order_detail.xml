<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <!-- ===== Status card ===== -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/textOrderNo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.PrintXpress.Title" />

                                    <TextView
                                        android:id="@+id/textPlaced"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.PrintXpress.Caption" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/textStatus"
                                    style="@style/PrintXpress.StatusPill" />
                            </LinearLayout>

                            <com.example.printexpress.ui.common.OrderStatusView
                                android:id="@+id/statusView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="22dp" />

                            <TextView
                                android:id="@+id/textCancelled"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:background="@drawable/bg_rounded"
                                android:backgroundTint="#33EF5350"
                                android:padding="12dp"
                                android:text="This order was cancelled."
                                android:textColor="@color/status_cancelled"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Items ===== -->
                    <TextView style="@style/PrintXpress.SectionLabel" android:text="Items" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/containerItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Pickup / delivery ===== -->
                    <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/fulfilment" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/imageFulfilment"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_icon_soft"
                                    android:contentDescription="@null"
                                    android:padding="9dp"
                                    app:tint="@color/px_primary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/textFulfilment"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.PrintXpress.Subtitle" />

                                    <TextView
                                        android:id="@+id/textFulfilmentInfo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.PrintXpress.Body" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textNotes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textAppearance="@style/TextAppearance.PrintXpress.Body" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Price ===== -->
                    <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/price_summary" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.example.printexpress.ui.common.PriceSummaryView
                            android:id="@+id/priceSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="18dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Actions ===== -->
                    <LinearLayout
                        android:id="@+id/panelActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonReschedule"
                            style="@style/Widget.PrintXpress.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/reschedule"
                            app:icon="@drawable/ic_calendar"
                            app:iconTint="@color/px_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCancel"
                            style="@style/Widget.PrintXpress.Button.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/cancel_order"
                            app:icon="@drawable/ic_delete"
                            app:iconTint="@color/px_error" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textCannotChange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/cannot_change"
                        android:textAppearance="@style/TextAppearance.PrintXpress.Body"
                        app:drawableStartCompat="@drawable/ic_info"
                        app:drawableTint="@color/px_primary" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.example.printexpress.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
