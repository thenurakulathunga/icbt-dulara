<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- ===== Product header ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/imageIcon"
                                style="@style/Widget.PrintXpress.Thumb"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:contentDescription="@null"
                                android:padding="18dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textCategory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/px_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/TextAppearance.PrintXpress.Title" />

                                <TextView
                                    android:id="@+id/textFromPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/px_primary"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textAppearance="@style/TextAppearance.PrintXpress.Body" />

                        <TextView
                            android:id="@+id/textTurnaround"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/px_text_primary"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_calendar"
                            app:drawableTint="@color/px_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Size ===== -->
                <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/size" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <!-- ===== Material ===== -->
                <LinearLayout
                    android:id="@+id/sectionMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/material" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMaterial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />
                </LinearLayout>

                <!-- ===== Quantity ===== -->
                <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/quantity" />

                <com.example.printexpress.ui.common.QuantityView
                    android:id="@+id/quantityView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textQuantityRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Caption" />

                <TextView
                    android:id="@+id/textQuantityError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/px_error"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- ===== Artwork ===== -->
                <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/artwork" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonModeUpload"
                        style="@style/Widget.PrintXpress.Toggle"
                        android:text="@string/upload_design"
                        app:icon="@drawable/ic_upload" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonModeText"
                        style="@style/Widget.PrintXpress.Toggle"
                        android:text="@string/enter_text"
                        app:icon="@drawable/ic_edit" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panelUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_soft"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_folder"
                            app:tint="@color/px_primary" />

                        <TextView
                            android:id="@+id/textDesign"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/choose_design"
                            android:textAppearance="@style/TextAppearance.PrintXpress.Body" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonChooseDesign"
                            style="@style/Widget.PrintXpress.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputCustomText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/custom_text"
                    android:visibility="gone"
                    app:counterEnabled="true"
                    app:counterMaxLength="200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="200"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== Pickup / delivery ===== -->
                <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/fulfilment" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleFulfilment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPickup"
                        style="@style/Widget.PrintXpress.Toggle"
                        android:text="@string/pickup"
                        app:icon="@drawable/ic_store" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDelivery"
                        style="@style/Widget.PrintXpress.Toggle"
                        android:text="@string/delivery"
                        app:icon="@drawable/ic_truck" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/textPickupInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/pickup_info"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Body"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="@color/px_primary" />

                <LinearLayout
                    android:id="@+id/panelDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputAddress"
                        style="@style/Widget.PrintXpress.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/delivery_address"
                        app:helperText="Delivery fee: LKR 350.00 anywhere in Sri Lanka"
                        app:startIconDrawable="@drawable/ic_location">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dropdownAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddAddress"
                        style="@style/Widget.PrintXpress.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/add_address"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_pickup"
                    app:startIconDrawable="@drawable/ic_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== Promo code ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputPromo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/promo_code"
                        app:startIconDrawable="@drawable/ic_offer">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLength="20"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonApplyPromo"
                        style="@style/Widget.PrintXpress.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/apply" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textPromoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/px_success"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_check"
                    app:drawableTint="@color/px_success" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/notes"
                    app:counterEnabled="true"
                    app:counterMaxLength="300">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="300" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== Price ===== -->
                <TextView style="@style/PrintXpress.SectionLabel" android:text="@string/price_summary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.example.printexpress.ui.common.PriceSummaryView
                        android:id="@+id/priceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <com.example.printexpress.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ===== Sticky bottom bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/px_surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total"
                android:textAppearance="@style/TextAppearance.PrintXpress.Caption" />

            <TextView
                android:id="@+id/textBottomTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PrintXpress.Price" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPlaceOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/place_order" />
    </LinearLayout>
</LinearLayout>
